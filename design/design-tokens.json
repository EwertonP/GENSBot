{
  "$description": "Tokens da identidade Agência GENS, extraídos de https://www.agenciagens.com.br/servicos/ em 2026-09-18. Formato W3C DTCG. Tokens com gens.confidence 'high' vieram de CSS custom properties explícitas.",
  "color": {
    "paper": {
      "$value": "#f7f8f2",
      "$type": "color",
      "$description": "Fundo base da aplicação. Off-white quente, nunca branco puro.",
      "$extensions": { "gens.confidence": "high", "gens.source": "--paper" }
    },
    "hero-soft": {
      "$value": "#edf4d8",
      "$type": "color",
      "$description": "Fundo de seção suave, usado em bandas alternadas com paper.",
      "$extensions": { "gens.confidence": "high", "gens.source": "--hero-soft" }
    },
    "ink": {
      "$value": "#192313",
      "$type": "color",
      "$description": "Texto principal e fundo de botão primário. Verde quase preto.",
      "$extensions": { "gens.confidence": "high", "gens.source": "--ink" }
    },
    "deep": {
      "$value": "#162d16",
      "$type": "color",
      "$description": "Superfície escura para cards de destaque e base do dark mode.",
      "$extensions": { "gens.confidence": "high", "gens.source": "--deep" }
    },
    "muted": {
      "$value": "#59614f",
      "$type": "color",
      "$description": "Texto secundário. AA sobre paper, não AAA — evitar em texto pequeno crítico.",
      "$extensions": { "gens.confidence": "high", "gens.source": "--muted" }
    },
    "lime": {
      "$value": "#d8ff3c",
      "$type": "color",
      "$description": "Acento de marca, alta voltagem. Único ponto vibrante do sistema. Sempre com texto ink.",
      "$extensions": { "gens.confidence": "high", "gens.source": "--lime" }
    },
    "brand": {
      "$value": "#bada55",
      "$type": "color",
      "$description": "Verde de marca secundário, menos saturado que lime.",
      "$extensions": { "gens.confidence": "high", "gens.source": "--brand" }
    },
    "line": {
      "$value": "#d9dfce",
      "$type": "color",
      "$description": "Borda e divisor padrão, 1px.",
      "$extensions": { "gens.confidence": "high", "gens.source": "--line" }
    },
    "line-strong": {
      "$value": "#bac8a1",
      "$type": "color",
      "$description": "Borda com mais presença, para cards em destaque.",
      "$extensions": { "gens.confidence": "medium", "gens.source": "hardcoded no CSS" }
    },
    "line-deep": {
      "$value": "#657e48",
      "$type": "color",
      "$description": "Borda escura sobre fundo claro, usada em badges circulares.",
      "$extensions": { "gens.confidence": "medium", "gens.source": "hardcoded no CSS" }
    }
  },
  "shadow": {
    "soft": {
      "$value": { "offsetX": "5px", "offsetY": "5px", "blur": "0", "spread": "0", "color": "#58753515" },
      "$type": "shadow",
      "$description": "Elevação padrão de card. SEM BLUR — este é o gesto de marca.",
      "$extensions": { "gens.confidence": "high" }
    },
    "strong": {
      "$value": { "offsetX": "7px", "offsetY": "8px", "blur": "0", "spread": "0", "color": "#1b2b1820" },
      "$type": "shadow",
      "$description": "Elevação de card em destaque. Sem blur.",
      "$extensions": { "gens.confidence": "high" }
    },
    "solid": {
      "$value": { "offsetX": "9px", "offsetY": "9px", "blur": "0", "spread": "0", "color": "#bdd094" },
      "$type": "shadow",
      "$description": "Sombra opaca verde. Reservada para o elemento mais importante da tela.",
      "$extensions": { "gens.confidence": "high" }
    }
  },
  "fontFamily": {
    "sans": {
      "$value": "Sora, system-ui, sans-serif",
      "$type": "fontFamily",
      "$extensions": { "gens.confidence": "high", "gens.license": "SIL OFL" }
    }
  },
  "typography": {
    "display": {
      "$value": { "fontFamily": "{fontFamily.sans}", "fontSize": "clamp(38px, 5vw, 70px)", "fontWeight": 600, "lineHeight": 1.05, "letterSpacing": "-0.055em" },
      "$type": "typography"
    },
    "h1": {
      "$value": { "fontFamily": "{fontFamily.sans}", "fontSize": "clamp(42px, 4.3vw, 64px)", "fontWeight": 600, "lineHeight": 1.1, "letterSpacing": "-0.05em" },
      "$type": "typography"
    },
    "h2": {
      "$value": { "fontFamily": "{fontFamily.sans}", "fontSize": "clamp(34px, 4.1vw, 55px)", "fontWeight": 600, "lineHeight": 1.15, "letterSpacing": "-0.04em" },
      "$type": "typography"
    },
    "h3": {
      "$value": { "fontFamily": "{fontFamily.sans}", "fontSize": "clamp(20px, 2.2vw, 28px)", "fontWeight": 600, "lineHeight": 1.3, "letterSpacing": "-0.035em" },
      "$type": "typography"
    },
    "body": {
      "$value": { "fontFamily": "{fontFamily.sans}", "fontSize": "16px", "fontWeight": 400, "lineHeight": 1.65, "letterSpacing": "0" },
      "$type": "typography"
    },
    "label": {
      "$value": { "fontFamily": "{fontFamily.sans}", "fontSize": "14px", "fontWeight": 500, "lineHeight": 1.4, "letterSpacing": "0.08em" },
      "$type": "typography"
    },
    "eyebrow": {
      "$value": { "fontFamily": "{fontFamily.sans}", "fontSize": "13px", "fontWeight": 600, "lineHeight": 1.2, "letterSpacing": "0.15em" },
      "$type": "typography",
      "$description": "Kicker em caixa alta. O tracking positivo é polaridade deliberada contra o tracking negativo dos displays."
    }
  },
  "radius": {
    "xs": { "$value": "3px", "$type": "dimension" },
    "sm": { "$value": "5px", "$type": "dimension", "$description": "Botões e inputs. O raio mais comum do sistema." },
    "md": { "$value": "8px", "$type": "dimension" },
    "lg": { "$value": "12px", "$type": "dimension", "$description": "Cards." },
    "xl": { "$value": "20px", "$type": "dimension", "$description": "Exceção — poucos elementos grandes." },
    "full": { "$value": "50%", "$type": "dimension", "$description": "Badges numerados, avatares. Padrão mais frequente do site." }
  },
  "spacing": {
    "$description": "Escala PROPOSTA, não extraída do site. Tratar como decisão nova.",
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" },
    "8": { "$value": "32px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" },
    "16": { "$value": "64px", "$type": "dimension" },
    "24": { "$value": "96px", "$type": "dimension" },
    "32": { "$value": "128px", "$type": "dimension" }
  },
  "motion": {
    "ease": {
      "$value": "cubic-bezier(0.16, 1, 0.3, 1)",
      "$type": "cubicBezier",
      "$extensions": { "gens.confidence": "high", "gens.source": "--ease" }
    },
    "duration-fast": { "$value": "200ms", "$type": "duration" },
    "duration-base": { "$value": "250ms", "$type": "duration" },
    "duration-slow": { "$value": "500ms", "$type": "duration" }
  }
}
